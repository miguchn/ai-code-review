# AI Code Review — Docker Compose 试用环境变量
# 复制为 .env 后按需修改：cp .env.example .env

# 凭据主密钥（必填）。生成命令：
#   openssl rand -base64 32
ACR_CREDENTIAL_MASTER_KEY=

# MySQL root 密码（须与 backend 使用同一值；默认与本地 dev 对齐）
MYSQL_ROOT_PASSWORD=root

# 可选：复用宿主机已有 MySQL。默认连接 Compose 内置 mysql 服务。
# macOS / Windows 使用 host.docker.internal；Linux 由 Compose 自动映射 host-gateway。
# ACR_MYSQL_HOST=host.docker.internal
# ACR_MYSQL_PORT=3306
# ACR_MYSQL_DATABASE=ai_code_review
# ACR_MYSQL_USERNAME=root
# ACR_MYSQL_PASSWORD=root

# Redis 密码（须与 backend 使用同一值；默认与本地 dev 对齐）
REDIS_PASSWORD=redis

# 可选：OCR_ENGINE 审查方式的容器内 CLI 命令/绝对路径。默认镜像不安装该 CLI。
# ACR_OCR_EXECUTABLE=ocr

# 可选：Webhook 回调外网 base（试用默认本机前端入口）
# ACR_WEBHOOK_CALLBACK_URL=http://127.0.0.1

# 可选：是否允许 HTTP / 内网模型端点（试用默认 true）
# ACR_LLM_ALLOW_HTTP=true
# ACR_LLM_ALLOW_PRIVATE_ENDPOINTS=true
